{
  "name": "hostlane-desktop",
  "productName": "Hostlane",
  "version": "0.1.0",
  "description": "Hostlane desktop: manage hosts, ports, tunnels and approvals for your own agent.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:cli": "cargo build --release -p hostlane-cli --manifest-path ../../Cargo.toml",
    "pack": "npm run build:cli && npm run build && electron-builder --dir -c.mac.identity=null",
    "dist": "npm run build:cli && npm run build && electron-builder",
    "dist:mac": "npm run build:cli && npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build:cli && npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.78.0",
    "prettier": "^3.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "electron": true,
    "electron-winstaller": true,
    "fsevents": false
  },
  "author": "Hostlane",
  "license": "MIT"
}

{
  "name": "hostlane-desktop",
  "productName": "Hostlane",
  "version": "1.0.3",
  "description": "Hostlane desktop: manage hosts, ports, tunnels and approvals for your own agent.",
  "private": true,
  "scripts": {
    "dev": "node scripts/runtime.mjs && tauri dev",
    "start": "npm run dev",
    "web:dev": "vite --config vite.tauri.config.mts",
    "web:build": "vite build --config vite.tauri.config.mts",
    "build": "npm run typecheck && npm run build:cli && tauri build --no-bundle",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build:cli": "node scripts/runtime.mjs release",
    "pack": "npm run build",
    "dist": "npm run typecheck && npm run build:cli && tauri build",
    "dist:mac": "npm run dist -- --bundles app,dmg",
    "dist:win": "npm run dist -- --bundles nsis",
    "dist:linux": "npm run dist -- --bundles appimage",
    "icon": "tauri icon build/icon.png",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "prettier": "^3.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "allowScripts": {
    "fsevents": false
  },
  "author": "Hostlane",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.5"
  }
}
